{
  "name": "campusflow",
  "version": "1.1.1",
  "description": "CampusFlow - 大学生专属时间规划",
  "author": "CampusFlow",
  "main": "main.js",
  "scripts": {
    "css": "tailwindcss -i src/input.css -o assets/css/tailwind.css --minify",
    "css:watch": "tailwindcss -i src/input.css -o assets/css/tailwind.css --watch",
    "start": "electron .",
    "build": "npm run css",
    "build:app": "npm run css && electron-builder",
    "build:win": "npm run css && electron-builder --win",
    "build:mac": "npm run css && electron-builder --mac",
    "build:linux": "npm run css && electron-builder --linux",
    "check": "node scripts/check-assets.js",
    "test": "node tests/scheduler.test.js",
    "verify": "npm test && npm run check"
  },
  "build": {
    "appId": "com.campusflow.app",
    "productName": "CampusFlow",
    "directories": {
      "output": "dist"
    },
    "files": [
      "*.html",
      "main.js",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ]
    }
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "tailwindcss": "^3.4.17"
  }
}
